# Copy to .env (or .env.local) and fill in. Never commit the real file.

# Supabase → Project Settings → API Keys (both are safe in the browser; data is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional, local only: database password, used to run SQL migrations with psql.
# Not needed by the app. Do NOT add it to Vercel.
SUPABASE_PASSWORD=
