# Copy to .env (or .env.local) and fill in. Never commit the real file.

# Supabase → Project Settings → API Keys (both are safe in the browser; data is protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional, local only: database password, used to run SQL migrations with psql.
# Not needed by the app. Do NOT add it to Vercel.
SUPABASE_PASSWORD=

# Optional: search engine ownership codes (meta tag "content" value only)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
# Optional: public site URL used for canonical links and the sitemap
NEXT_PUBLIC_SITE_URL=https://getrepup.vercel.app

# Food mode (server only: never add NEXT_PUBLIC_ to these, never commit the real values)
# USDA FoodData Central key: https://fdc.nal.usda.gov/api-key-signup
USDA_API_KEY=
# Supabase → Project Settings → API Keys → Secret keys. Lets the server save foods found at
# USDA / by barcode to the shared food list. Optional: search works without it, just slower.
SUPABASE_SECRET_KEY=
